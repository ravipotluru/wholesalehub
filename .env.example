# WholesaleHub Environment Configuration
# Copy to .env.local and fill in values

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WholesaleHub
NODE_ENV=development

# ─── Database (PostgreSQL) ───
# Connection string for the PostgreSQL database used by Prisma
DATABASE_URL=postgresql://wholesalehub:wholesalehub_dev@localhost:5432/wholesalehub

# ─── Redis ───
# Used for caching, session storage, and rate limiting
REDIS_URL=redis://localhost:6379

# ─── Auth (NextAuth.js) ───
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-random-string
NEXTAUTH_URL=http://localhost:3000

# ─── AWS Bedrock (primary AI provider) ───
AWS_REGION=us-east-1
# Optional — only required for AI features (semantic search, document extraction)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# ─── OpenAI (fallback for embeddings) ───
# Optional — used as fallback if AWS Bedrock is unavailable
OPENAI_API_KEY=

# ─── Webhook Security ───
# HMAC-SHA256 secret for verifying incoming supplier webhook payloads.
# Generate with: openssl rand -hex 32
# The literal value `whsec_demo_secret_key` is REJECTED in production.
WEBHOOK_SECRET=changeme_run_openssl_rand_hex_32

# ─── Anomaly Detection ───
ANOMALY_PRICE_ZSCORE_THRESHOLD=2.0
ANOMALY_ORDER_VALUE_RATIO=3.0
ANOMALY_SHORTAGE_RATE_THRESHOLD=5.0

# ─── PostHog product analytics ───
# PostHog product analytics — optional. Sign up at posthog.com (free tier
# generous; self-hostable). When unset, capture() silently no-ops.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
