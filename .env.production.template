# WholesaleHub — Production Environment Template
#
# This file documents every environment variable that must be set in Vercel
# (or any other production host) for a real deployment. Copy each variable
# into your Vercel project's Environment Variables UI under the appropriate
# environment scope (Production / Preview / Development), or use
# `vercel env add <NAME> production` from the CLI.
#
# DO NOT commit real values. This template is illustrative only. Where a
# value can be generated locally, the comment shows the command.
#
# Grouping below mirrors the deployment checklist in docs/DEPLOYMENT.md.

# ─────────────────────────────────────────────────────────────────────────
# Required — the app will not boot without these
# ─────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Provision via Neon (https://neon.tech) and
# copy the pooled connection URL. Must include `sslmode=require`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis connection string. Provision via Upstash (https://upstash.com) and
# copy the `rediss://` (TLS) URL.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# NextAuth.js signing secret for JWT sessions. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Public canonical URL of the deployment. Must match the domain Vercel
# serves the app from (or your Cloudflare-fronted custom domain).
NEXTAUTH_URL=https://app.wholesalehub.com

# HMAC-SHA256 secret used to verify supplier ASN webhook signatures at
# /api/webhooks/inventory. Generate with:
#   openssl rand -hex 32
# The literal `whsec_demo_secret_key` is REJECTED in production by the
# webhook route and the app will refuse to process any payload until this
# is rotated to a real value.
WEBHOOK_SECRET=

# Bearer token Vercel Cron sends in the Authorization header when invoking
# /api/cron/* routes. Generate with:
#   openssl rand -hex 32
# Anything that does not match this exact value gets a 401.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Email — Resend transactional sender
# ─────────────────────────────────────────────────────────────────────────
# Sign up at https://resend.com, verify your sending domain (DKIM/SPF DNS
# records), then create an API key scoped to "Sending access".

# Resend API key. Format: re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Verified sending address. Must be on a domain you've verified in Resend.
RESEND_FROM_EMAIL=no-reply@wholesalehub.com

# Reply-to address shown to recipients. Often a real shared inbox.
RESEND_REPLY_TO=support@wholesalehub.com

# ─────────────────────────────────────────────────────────────────────────
# AI / Bedrock — optional; falls back to deterministic mocks if absent
# ─────────────────────────────────────────────────────────────────────────
# When unset, embeddings + extraction degrade to mock values that keep the
# UI green for demos but will not return real semantic search results.

# AWS region with Bedrock + Claude model access enabled.
AWS_REGION=us-east-1

# IAM credentials with Bedrock invoke permission. Prefer a dedicated
# user/role scoped to bedrock:InvokeModel only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model identifiers. Override only if you've been granted a different
# model id by AWS account-level access controls.
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# OpenAI fallback for embeddings if Bedrock is unavailable. Optional.
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Observability — Sentry + PostHog
# ─────────────────────────────────────────────────────────────────────────
# Sentry: create a project at https://sentry.io for the Next.js framework.
# Copy the DSN from "Settings → Client Keys (DSN)".

# Server-side Sentry DSN. Used by route handlers + cron.
SENTRY_DSN=https://PUBLIC_KEY@oORG.ingest.sentry.io/PROJECT_ID

# Browser-exposed Sentry DSN. Same value as SENTRY_DSN unless you split
# server vs. client into separate Sentry projects (recommended at scale).
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@oORG.ingest.sentry.io/PROJECT_ID

# Sentry source-map upload auth token. Create at:
#   https://sentry.io/settings/account/api/auth-tokens/
# with scopes: project:releases, project:write.
SENTRY_AUTH_TOKEN=

# Sentry org + project slug from the project URL.
SENTRY_ORG=wholesalehub
SENTRY_PROJECT=wholesalehub

# PostHog product analytics. Sign up at https://posthog.com (or self-host).
# Use a "Project API Key" scoped to event ingestion only.
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────────────────────────────────
# Compliance / monitoring — used by GitHub Actions Health Monitor
# ─────────────────────────────────────────────────────────────────────────

# Full URL of the deployed health endpoint. The GH Actions Health Monitor
# probes this every 10 minutes and pages on non-200.
PROD_HEALTH_URL=https://app.wholesalehub.com/api/health

# Slack/Teams/Discord-compatible incoming webhook that receives a JSON
# payload `{ text, url, run }` when the health probe fails. Optional; if
# absent the workflow logs the failure and stops.
ALERT_WEBHOOK_URL=
